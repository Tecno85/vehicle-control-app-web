# Configuración de core-service.
# Copia este archivo como .env en esta misma carpeta (apps/core-service) y
# completa los valores. El .env no se sube al repositorio; este ejemplo sí, y
# por eso no lleva valores reales.

# Dirección GraphQL del proyecto de Hasura Cloud. Termina en /v1/graphql.
HASURA_GRAPHQL_URL=https://tu-proyecto.hasura.app/v1/graphql

# Secreto de administración de Hasura. Solo lo usa core-service: nunca va en la
# web-app ni en una variable VITE_.
HASURA_ADMIN_SECRET=

# Tiempo máximo de espera de cada consulta, en milisegundos. Si se omite, 5000.
HASURA_TIMEOUT_MS=5000
